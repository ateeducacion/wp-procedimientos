# Configuración del despliegue. Copia a .env y rellena:
#
#   cp .env.dist .env
#
# `.env` está en el `.gitignore`: **las credenciales no se versionan nunca**, y
# los valores de destino tampoco —dónde se despliega es de cada instalación—.
#
# Lo lee `npm run snippets`, que es el cliente de Code Snippets
# (`@erseco/code-snippets-client`, en `package.json`). Carga este fichero
# directamente: no hace falta `export`, ni `source`, ni una shell Unix. Dentro
# no se expanden `$HOME` ni ninguna otra variable.
#
#   npm run snippets -- list
#   npm run snippets -- push <id> --file snippets/prc-procedimientos-app.bundle.php --dry-run
#
# Toda escritura remota exige `--yes`; sin él, el cliente se niega.

# El sitio de destino. Si es un subsitio de un multisitio, la URL es la del
# subsitio y `WP_NETWORK` dice si Code Snippets está activado en red.
WP_URL=
WP_NETWORK=false

# Cómo se entra. `application-password` es lo normal; `cas` si el sitio está
# detrás de un inicio de sesión único, y entonces hace falta `CAS_LOGIN_URL`.
WP_AUTH=application-password
WP_USERNAME=
WP_PASSWORD=
CAS_LOGIN_URL=

# Página del sitio donde vive el aplicativo. El ID es lo que no cambia si
# alguien renombra la página; la URL es lo que se le pasa a la gente. Salen del
# editor de la página (`post=…` en su dirección).
PRC_PAGINA_ID=
PRC_PAGINA_URL=

# Cabecera y tiempo de espera de las peticiones, en milisegundos.
WP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:140.0) Gecko/20100101 Firefox/140.0"
WP_TIMEOUT_MS=120000

# Solo para pruebas locales desechables: en un destino real, nunca.
WP_ALLOW_HTTP=false
