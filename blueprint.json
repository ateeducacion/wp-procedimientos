{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/gestion-de-procedimientos/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "siteOptions": {
    "blogname": "Procedimientos para los centros educativos"
  },
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "es_ES"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "code-snippets"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "members"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wpfront-user-role-editor"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/prc-dev/snippets",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/ateeducacion/wp-procedimientos.git",
        "ref": "main",
        "path": "snippets",
        "refType": "branch"
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/prc-dev/scripts",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/ateeducacion/wp-procedimientos.git",
        "ref": "main",
        "path": "scripts",
        "refType": "branch"
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/prc-dev/src",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/ateeducacion/wp-procedimientos.git",
        "ref": "main",
        "path": "src",
        "refType": "branch"
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/mu-plugins",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/ateeducacion/wp-procedimientos.git",
        "ref": "main",
        "refType": "branch",
        "path": "scripts/mu-plugins"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/prc-dev/scripts/sync-snippets.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/prc-dev/scripts/provision-roles.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/prc-dev/scripts/setup-vocabulary.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/prc-dev/scripts/setup-pages.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/prc-dev/scripts/seed-demo.php';"
    }
  ],
  "meta": {
    "title": "Procedimientos — convocatorias para los centros educativos",
    "author": "ateeducacion",
    "description": "Prueba el aplicativo completo: tipos de contenido, roles, taller del procedimiento y solicitud del centro, con datos de demostración."
  }
}
